# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env to git (add it to .gitignore).

TZ=Europe/Belgrade

# Server's static LAN IP
LAN_IP=192.168.1.xx

# Where container configs and media live
DOCKER_DIR=/home/stefan/docker
MEDIA_DIR=/mnt/storage

# Output of: id stefan
PUID=1000
PGID=1000

# Output of: getent group render | cut -d: -f3   and   getent group video | cut -d: -f3
RENDER_GID=991
VIDEO_GID=44

# Docker network "media-stack-network"
#   true  = "current": the network already exists (check: docker network ls)
#   false = "new":     docker compose creates it on the first `up`
# Compose cannot read the words current/new here, so use true/false.
NETWORK_EXTERNAL=true

# DuckDNS: subdomain only, no ".duckdns.org". Use a NEW token (regenerate on duckdns.org).
DUCKDNS_SUBDOMAIN=user
DUCKDNS_TOKEN=token

# CommaFeed: any random string, at least 16 characters (keeps you logged in across restarts)
COMMAFEED_KEY=change-me-to-a-long-random-string

# Immich (profile "photos")
# Photo/video library location: needs plenty of free space
IMMICH_UPLOAD_DIR=/mnt/storage/immich
# Use only A-Za-z0-9 in the password
IMMICH_DB_PASSWORD=change-me-letters-and-digits-only
# Pin a version once it works. Check Immich's release notes before upgrading.
IMMICH_VERSION=release

HOMARR_KEY=key

BESZEL_KEY="key"
BESZEL_TOKEN=token

# Optional services, comma-separated. Available profiles:
#   rss         FreshRSS
#   arr         	Prowlarr, Sonarr, Radarr
#   jellyseerr  	Seerr (media requests for Jellyfin)
#   photos      	Immich (no machine learning)
#   vpn         	WireGuard (wg-easy)
#   files       	File Browser
#   minecraft   	Crafty
#   dashboard		Homarr
#   monitoring  	Beszel
#   monitoring-agent 	Beszel Agent
COMPOSE_PROFILES=rss,photos,vpn,files,arr,jellyseerr,dashboard,monitoring #monitoring-agent


